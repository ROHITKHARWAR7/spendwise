generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  transactions Transaction[]
  budgets      Budget[]
  goals        Goal[]
}

model Category {
  id        String   @id @default(cuid())
  name      String
  icon      String?
  color     String?
  createdAt DateTime @default(now())

  transactions Transaction[]
  budgets      Budget[]

  @@unique([name])
}

model Transaction {
  id          String          @id @default(cuid())
  amount      Decimal         @db.Decimal(12, 2)
  type        TransactionType
  description String?
  date        DateTime        @default(now())
  paymentMethod PaymentMethod @default(OTHER)
  notes       String?

  userId     String
  categoryId String

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  category Category @relation(fields: [categoryId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([categoryId])
  @@index([date])
  @@index([type])
}

model Budget {
  id       String  @id @default(cuid())
  amount   Decimal @db.Decimal(12, 2)
  month    Int
  year     Int

  userId     String
  categoryId String

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, categoryId, month, year])
}

model Goal {
  id          String   @id @default(cuid())
  name        String
  target      Decimal  @db.Decimal(12, 2)
  current     Decimal  @default(0) @db.Decimal(12, 2)
  deadline    DateTime?
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  userId String
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

enum TransactionType {
  EXPENSE
  INCOME
}

enum PaymentMethod {
  CASH
  CARD
  UPI
  BANK_TRANSFER
  OTHER
}